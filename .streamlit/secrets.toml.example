# Ask Zia (optional AI layer) configuration.
#
# To enable Ask Zia for everyone:
#   - Local dev: copy this file to ".streamlit/secrets.toml" and fill in a key.
#   - Streamlit Community Cloud: App -> Settings -> Secrets, and paste these lines.
#
# Ask Zia calls any OpenAI-compatible chat API. A FREE tier works well:
#   Groq (default, fast, free):  https://api.groq.com/openai/v1   model: llama-3.1-8b-instant
#   OpenAI:                      https://api.openai.com/v1         model: gpt-4o-mini
#   Google Gemini (OpenAI-compat): https://generativelanguage.googleapis.com/v1beta/openai  model: gemini-2.0-flash
#
# secrets.toml is gitignored so your key is never committed.

LLM_API_KEY = "your-free-api-key-here"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "llama-3.1-8b-instant"
